<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#123b8a">
<title>SwiftData NG | Fast Data. Easy Airtime.</title>
<style>
:root{--blue:#155eef;--navy:#102a56;--ink:#172033;--muted:#667085;--bg:#f4f7fc;--line:#e5eaf2;--white:#fff;--green:#079455;--red:#d92d20}
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}button,input,select{font:inherit}button{cursor:pointer;border:0;border-radius:10px;padding:12px 16px;font-weight:700}.primary{background:var(--blue);color:#fff}.secondary{background:#eaf1ff;color:var(--blue)}.dark{background:var(--navy);color:#fff}.danger{background:#fff0ef;color:var(--red)}.muted{color:var(--muted)}.small{font-size:12px}.hidden{display:none!important}
header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}.nav{max-width:1150px;margin:auto;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:15px}.brand{font-size:22px;font-weight:900;color:var(--navy);letter-spacing:-.7px}.brand span{color:var(--blue)}.nav-actions{display:flex;gap:8px;align-items:center}
main{max-width:1150px;margin:auto;padding:24px 20px 60px}.hero{background:linear-gradient(120deg,#102a56,#155eef);color:#fff;border-radius:22px;padding:42px 30px;display:grid;grid-template-columns:1.5fr 1fr;gap:24px;align-items:center}.hero h1{font-size:clamp(30px,5vw,48px);line-height:1.08;margin:0 0 14px}.hero p{color:#e1eaff;line-height:1.6;max-width:570px}.hero-card{background:#fff;color:var(--ink);padding:22px;border-radius:18px;box-shadow:0 14px 40px #001b5525}.hero-card h3{margin-top:0}.section{margin-top:28px}.section-title{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px}.section-title h2{margin:0;font-size:23px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:19px;box-shadow:0 3px 12px #102a5608}.card h3{margin:0 0 8px}.network-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.network{background:#fff;border:1px solid var(--line);padding:15px;text-align:center;border-radius:13px;font-weight:800}.network.active{border:2px solid var(--blue);background:#eff5ff;color:var(--blue)}
label{display:block;font-size:13px;font-weight:700;margin:12px 0 6px}input,select{width:100%;padding:13px;border:1px solid #d0d5dd;border-radius:10px;background:#fff;outline:none}input:focus,select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #155eef18}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.plans{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.plan{background:#fff;border:1px solid var(--line);padding:14px;border-radius:12px;text-align:left}.plan strong{display:block;font-size:18px;margin-bottom:5px}.plan.active{border:2px solid var(--blue);background:#eff5ff}
.notice{padding:13px 15px;border-radius:12px;background:#fff8e6;color:#8a5700;border:1px solid #ffe2a8;line-height:1.5;font-size:13px}.success{background:#ecfdf3;color:#067647;border-color:#abefc6}.footer{margin-top:35px;text-align:center;color:var(--muted);font-size:13px}
.modal{position:fixed;inset:0;background:#10182899;display:flex;align-items:center;justify-content:center;padding:18px;z-index:30}.modal-box{width:min(460px,100%);background:#fff;border-radius:18px;padding:24px;max-height:90vh;overflow:auto}.modal-head{display:flex;justify-content:space-between;align-items:center}.close{background:#f2f4f7;padding:8px 12px}
.app-layout{display:grid;grid-template-columns:230px 1fr;gap:18px}.sidebar{background:#fff;border:1px solid var(--line);border-radius:16px;padding:15px;height:max-content;position:sticky;top:82px}.side-btn{display:block;width:100%;text-align:left;background:transparent;color:#344054;margin:3px 0}.side-btn.active{background:#eff5ff;color:var(--blue)}.dash-main{min-width:0}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.stat{background:#fff;padding:17px;border:1px solid var(--line);border-radius:14px}.stat strong{display:block;font-size:23px;margin-top:8px}.table-wrap{overflow:auto;background:#fff;border:1px solid var(--line);border-radius:14px}table{width:100%;border-collapse:collapse;min-width:550px}th,td{text-align:left;padding:13px;border-bottom:1px solid var(--line);font-size:13px}th{background:#f8fafc;color:#475467}.pill{display:inline-block;border-radius:20px;padding:4px 9px;background:#f2f4f7;font-size:11px;font-weight:700}.pill.pending{background:#fff4e5;color:#b54708}.pill.done{background:#ecfdf3;color:#067647}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding:30px 22px}.grid{grid-template-columns:1fr}.network-grid{grid-template-columns:repeat(2,1fr)}.plans{grid-template-columns:repeat(2,1fr)}.app-layout{grid-template-columns:1fr}.sidebar{position:static;display:grid;grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}.nav{padding:12px}.nav-actions button{padding:10px}.form-row{grid-template-columns:1fr}}
</style>
</head>
<body>
<header><div class="nav"><div class="brand">SwiftData <span>NG</span></div><div class="nav-actions"><button class="secondary" onclick="openModal('loginModal')">Customer Login</button><button class="secondary" onclick="openAdminLogin()">Admin Login</button><button class="primary" onclick="openModal('registerModal')">Create account</button></div></div></header>
<main id="home">
<section class="hero"><div><div class="pill" style="background:#ffffff22;color:#fff">FAST DATA. EASY AIRTIME.</div><h1>Stay connected, the easy way.</h1><p>Buy data and airtime for your favourite networks with a simple, clear experience. Your SwiftData NG account keeps your services and activity together.</p><button class="primary" onclick="openModal('registerModal')">Get started</button> <button class="secondary" onclick="document.getElementById('purchase').scrollIntoView({behavior:'smooth'})">Explore services</button></div><div class="hero-card"><h3>Quick purchase</h3><p class="muted small">Choose a service to get started. Purchases shown here are a demonstration until payment and VTU services are connected.</p><label>Service</label><select id="quickService"><option value="data">Buy Data</option><option value="airtime">Buy Airtime</option></select><label>Phone number</label><input id="quickPhone" placeholder="08012345678" inputmode="tel"><label>Network</label><select id="quickNetwork"><option>MTN</option><option>Airtel</option><option>Glo</option><option>9mobile</option></select><button class="primary" style="width:100%;margin-top:14px" onclick="quickStart()">Continue</button></div></section>
<section class="section" id="purchase"><div class="section-title"><h2>Our services</h2><span class="muted small">Simple and convenient</span></div><div class="grid"><div class="card"><h3>📶 Buy Data</h3><p class="muted">Choose a network and data plan for your phone.</p><button class="secondary" onclick="openModal('loginModal')">Buy data</button></div><div class="card"><h3>📱 Buy Airtime</h3><p class="muted">Select your network and enter an airtime amount.</p><button class="secondary" onclick="openModal('loginModal')">Buy airtime</button></div><div class="card"><h3>💳 Wallet</h3><p class="muted">View your wallet and funding activity from your account.</p><button class="secondary" onclick="openModal('loginModal')">Open wallet</button></div></div></section>
<section class="section"><div class="section-title"><h2>Supported networks</h2></div><div class="network-grid"><div class="network">MTN</div><div class="network">Airtel</div><div class="network">Glo</div><div class="network">9mobile</div></div></section>
<section class="section"><div class="notice">Demo notice: this website interface is prepared as a single-page front end. Real account security, wallet balances, payment processing, transaction records and airtime/data delivery must be connected to a secure backend and approved providers before customers can make real purchases.</div></section>
<div class="footer">© <span id="year"></span> SwiftData NG. All rights reserved.</div>
</main>
<main id="dashboard" class="hidden">
<div class="section-title"><div><h2 id="welcome">Customer dashboard</h2><span class="muted small" id="userEmail"></span></div><button class="danger" onclick="logout()">Logout</button></div>
<div class="app-layout"><aside class="sidebar" id="customerNav"><button class="side-btn active" onclick="showPage('overview',this)">Overview</button><button class="side-btn" onclick="showPage('buydata',this)">Buy data</button><button class="side-btn" onclick="showPage('buyairtime',this)">Buy airtime</button><button class="side-btn" onclick="showPage('wallet',this)">Wallet</button><button class="side-btn" onclick="showPage('history',this)">Transactions</button><button class="side-btn" onclick="showPage('profile',this)">My profile</button></aside>
<div class="dash-main">
<section id="page-overview" class="dash-page"><div class="stats"><div class="stat"><span class="muted small">Wallet balance</span><strong>₦0.00</strong></div><div class="stat"><span class="muted small">Total orders</span><strong>0</strong></div><div class="stat"><span class="muted small">Successful</span><strong>0</strong></div><div class="stat"><span class="muted small">Pending</span><strong>0</strong></div></div><div class="card section"><h3>Welcome to SwiftData NG</h3><p class="muted">Use the menu to explore data, airtime, wallet, transactions and profile. Live services will become available after secure backend integration.</p></div></section>
<section id="page-buydata" class="dash-page hidden"><div class="card"><h3>Buy data</h3><div class="notice">Demo screen only. No payment will be taken and no data will be delivered yet.</div><label>Network</label><select id="dataNetwork"><option>MTN</option><option>Airtel</option><option>Glo</option><option>9mobile</option></select><label>Phone number</label><input id="dataPhone" placeholder="08012345678" inputmode="tel"><label>Choose plan</label><div class="plans"><button class="plan" onclick="selectPlan(this,'500MB','₦300')"><strong>500MB</strong>₦300</button><button class="plan" onclick="selectPlan(this,'1GB','₦500')"><strong>1GB</strong>₦500</button><button class="plan" onclick="selectPlan(this,'2GB','₦950')"><strong>2GB</strong>₦950</button><button class="plan" onclick="selectPlan(this,'5GB','₦1,800')"><strong>5GB</strong>₦1,800</button></div><button class="primary" style="margin-top:16px" onclick="demoOrder('data')">Continue</button></div></section>
<section id="page-buyairtime" class="dash-page hidden"><div class="card"><h3>Buy airtime</h3><div class="notice">Demo screen only. Real airtime delivery is not connected.</div><label>Network</label><select id="airNetwork"><option>MTN</option><option>Airtel</option><option>Glo</option><option>9mobile</option></select><label>Phone number</label><input id="airPhone" placeholder="08012345678" inputmode="tel"><label>Amount (₦)</label><input id="airAmount" type="number" min="50" placeholder="Enter amount"><button class="primary" style="margin-top:16px" onclick="demoOrder('airtime')">Continue</button></div></section>
<section id="page-wallet" class="dash-page hidden"><div class="card"><h3>My wallet</h3><p class="muted">Available balance</p><h2>₦0.00</h2><div class="notice">Wallet funding is not active yet. Paystack or another payment provider must be securely connected first.</div><button class="primary" style="margin-top:14px" onclick="alert('Wallet funding will be enabled after secure payment integration.')">Fund wallet</button></div></section>
<section id="page-history" class="dash-page hidden"><div class="card"><h3>Transaction history</h3><div class="table-wrap"><table><thead><tr><th>Date</th><th>Type</th><th>Details</th><th>Amount</th><th>Status</th></tr></thead><tbody id="historyRows"><tr><td colspan="5" class="muted">No transactions yet.</td></tr></tbody></table></div></div></section>
<section id="page-profile" class="dash-page hidden"><div class="card"><h3>My profile</h3><label>Full name</label><input id="profileName" placeholder="Your full name"><label>Email address</label><input id="profileEmail" readonly><label>Phone number</label><input placeholder="Your phone number"><button class="primary" style="margin-top:14px" onclick="alert('Profile saving will be available after backend connection.')">Save changes</button></div></section>
</div></div>
<div class="section"><div class="notice">This is a front-end preview. Do not use it to collect real customer passwords or money until secure authentication, database rules and payment verification are implemented.</div></div>
</main>
<main id="admin" class="hidden">
<div class="section-title"><div><h2>SwiftData NG Admin Dashboard</h2><span class="muted small" id="adminEmail"></span></div><button class="danger" onclick="logout()">Admin Logout</button></div>
<div class="notice success">Administrator access verified by Supabase.</div>
<div class="stats section">
<div class="stat">Customers<strong>—</strong><span class="small muted">Connect customer data query</span></div>
<div class="stat">Orders<strong>—</strong><span class="small muted">Connect orders table</span></div>
<div class="stat">Sales<strong>—</strong><span class="small muted">Connect verified payments</span></div>
<div class="stat">Pending<strong>—</strong><span class="small muted">Connect pending orders</span></div>
</div>
<div class="grid section">
<div class="card"><h3>Customers</h3><p class="muted">Customer management interface. Live records require verified database queries and policies.</p></div>
<div class="card"><h3>Orders</h3><p class="muted">Review data and airtime orders after orders-table integration.</p></div>
<div class="card"><h3>Wallets & payments</h3><p class="muted">Wallet funding and adjustments must use secure server-side functions.</p></div>
<div class="card"><h3>Services & pricing</h3><p class="muted">Manage plans after admin-only database actions are implemented.</p></div>
<div class="card"><h3>Transactions</h3><p class="muted">View payment records after payment verification is connected.</p></div>
<div class="card"><h3>Reports</h3><p class="muted">Sales reports will populate when real transaction data is connected.</p></div>
</div>
<div class="notice section">This is the protected admin interface shell. It does not yet perform live customer, wallet, payment, order or pricing changes. Those actions must be implemented with secure database policies or Edge Functions before use.</div>
</main>
<div class="modal hidden" id="loginModal"><div class="modal-box"><div class="modal-head"><h2>Login</h2><button class="close" onclick="closeModal('loginModal')">✕</button></div><p class="muted small">Sign in with your SwiftData NG account.</p><label>Email address</label><input id="loginEmail" type="email" placeholder="you@example.com"><label>Password</label><input id="loginPassword" type="password" placeholder="Enter password"><button class="primary" style="width:100%;margin-top:18px" onclick="demoLogin()">Login</button><p class="small muted">New here? <a href="#" onclick="switchModal('loginModal','registerModal')">Create an account</a></p></div></div>
<div class="modal hidden" id="adminLoginModal"><div class="modal-box"><div class="modal-head"><h2>Administrator Login</h2><button class="close" onclick="closeModal('adminLoginModal')">✕</button></div><p class="muted small">For authorised SwiftData NG administrators only.</p><label>Admin email</label><input id="adminEmailInput" type="email" placeholder="Administrator email"><label>Password</label><input id="adminPasswordInput" type="password" placeholder="Your account password"><button class="primary" style="width:100%;margin-top:18px" onclick="adminLogin()">Secure Admin Login</button><p class="small muted">Access is checked against the admin_users table in Supabase.</p></div></div>
<div class="modal hidden" id="registerModal"><div class="modal-box"><div class="modal-head"><h2>Create account</h2><button class="close" onclick="closeModal('registerModal')">✕</button></div><p class="muted small">Create your account using Supabase authentication.</p><label>Full name</label><input id="regName" placeholder="Enter your full name"><label>Email address</label><input id="regEmail" type="email" placeholder="you@example.com"><label>Phone number</label><input id="regPhone" inputmode="tel" placeholder="08012345678"><label>Password</label><input id="regPassword" type="password" placeholder="Create a password"><button class="primary" style="width:100%;margin-top:18px" onclick="demoRegister()">Create account</button><p class="small muted">Already registered? <a href="#" onclick="switchModal('registerModal','loginModal')">Login</a></p></div></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL = "https://abhfvhdeaantgtnsdgkq.supabase.co";
const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_A9DIs_Hsqd95VrQkiBJpXQ_hbwbPHay";
const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);
let selectedPlan=null,currentUser=null;
document.getElementById('year').textContent=new Date().getFullYear();
(async function restoreSession(){
  const {data:{session}}=await supabaseClient.auth.getSession();
  if(session){
    currentUser={name:session.user.user_metadata?.full_name||'Customer',email:session.user.email};
    enterDashboard();
  }
})();
function openModal(id){document.getElementById(id).classList.remove('hidden')}
function closeModal(id){document.getElementById(id).classList.add('hidden')}
function switchModal(a,b){closeModal(a);openModal(b)}
function showOnly(id){['home','dashboard','admin'].forEach(x=>document.getElementById(x).classList.add('hidden'));document.getElementById(id).classList.remove('hidden');window.scrollTo(0,0)}
function openAdminLogin(){openModal('adminLoginModal')}
async function adminLogin(){
  const email=document.getElementById('adminEmailInput').value.trim();
  const password=document.getElementById('adminPasswordInput').value;
  if(!email||!password){alert('Enter your administrator email and password.');return}
  const button=document.querySelector('#adminLoginModal .primary');
  button.disabled=true;button.textContent='Checking access...';
  const {data,error}=await supabaseClient.auth.signInWithPassword({email,password});
  if(error){button.disabled=false;button.textContent='Secure Admin Login';alert('Admin login failed: '+error.message);return}
  // The database function checks auth.uid() against admin_users.
  const {data:isAdmin,error:roleError}=await supabaseClient.rpc('is_admin');
  if(roleError||isAdmin!==true){
    await supabaseClient.auth.signOut();
    button.disabled=false;button.textContent='Secure Admin Login';
    alert('This account is not authorised as an administrator. Customer access remains separate.');
    return;
  }
  currentUser={name:data.user.user_metadata?.full_name||'Administrator',email:data.user.email};
  document.getElementById('adminEmail').textContent=data.user.email;
  button.disabled=false;button.textContent='Secure Admin Login';
  closeModal('adminLoginModal');showOnly('admin');
}
async function demoRegister(){
  const name=document.getElementById('regName').value.trim();
  const email=document.getElementById('regEmail').value.trim();
  const phone=document.getElementById('regPhone').value.trim();
  const password=document.getElementById('regPassword').value;
  if(!name||!email||!password){alert('Please enter your name, email and password.');return}
  if(password.length<6){alert('Please use a password with at least 6 characters.');return}
  const button=document.querySelector('#registerModal .primary');
  button.disabled=true;button.textContent='Creating account...';
  const {data,error}=await supabaseClient.auth.signUp({email,password,options:{data:{full_name:name,phone:phone}}});
  button.disabled=false;button.textContent='Create account';
  if(error){alert('Registration failed: '+error.message);return}
  closeModal('registerModal');
  if(data.session){currentUser={name,email};enterDashboard();}
  else{alert('Your account request was received. Check your email for a confirmation link, then log in.');}
}
async function demoLogin(){
  const email=document.getElementById('loginEmail').value.trim();
  const password=document.getElementById('loginPassword').value;
  if(!email||!password){alert('Please enter your email and password.');return}
  const button=document.querySelector('#loginModal .primary');
  button.disabled=true;button.textContent='Signing in...';
  const {data,error}=await supabaseClient.auth.signInWithPassword({email,password});
  button.disabled=false;button.textContent='Login';
  if(error){alert('Login failed: '+error.message);return}
  currentUser={name:data.user.user_metadata?.full_name||'Customer',email:data.user.email};
  closeModal('loginModal');enterDashboard();
}
function enterDashboard(){showOnly('dashboard');document.getElementById('welcome').textContent='Welcome, '+currentUser.name;document.getElementById('userEmail').textContent=currentUser.email;document.getElementById('profileEmail').value=currentUser.email;document.getElementById('profileName').value=currentUser.name;showPage('overview',document.querySelector('.side-btn'))}
async function logout(){await supabaseClient.auth.signOut();currentUser=null;showOnly('home')}
function showPage(page,btn){document.querySelectorAll('.dash-page').forEach(x=>x.classList.add('hidden'));document.getElementById('page-'+page).classList.remove('hidden');document.querySelectorAll('.side-btn').forEach(x=>x.classList.remove('active'));if(btn)btn.classList.add('active')}
function selectPlan(btn,plan,price){document.querySelectorAll('.plan').forEach(x=>x.classList.remove('active'));btn.classList.add('active');selectedPlan={plan,price}}
function demoOrder(type){let phone=type==='data'?document.getElementById('dataPhone').value:document.getElementById('airPhone').value;if(!/^0\d{10}$/.test(phone)){alert('Enter a valid 11-digit Nigerian phone number.');return}if(type==='data'&&!selectedPlan){alert('Please select a data plan.');return}if(type==='airtime'&&Number(document.getElementById('airAmount').value)<50){alert('Enter an airtime amount of at least ₦50.');return}alert('This is a preview only. No order has been placed and no money has been charged. Real orders will work after backend and VTU integration.')}
function quickStart(){let phone=document.getElementById('quickPhone').value;if(!/^0\d{10}$/.test(phone)){alert('Enter a valid 11-digit Nigerian phone number.');return}openModal('loginModal')}
</script>
</body></html>
